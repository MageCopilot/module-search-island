{
    "name": "magecopilot/module-search-island",
    "description": "Drop-in <4ms In-Memory Search Island for Hyvä Themes & Luma powered by Typesense & Preact",
    "type": "magento2-module",
    "version": "1.0.0",
    "license": "OSL-3.0",
    "authors": [
        {
            "name": "MageCopilot Team",
            "email": "support@magecopilot.com",
            "homepage": "https://magecopilot.com"
        }
    ],
    "require": {
        "php": "~8.1.0 || ~8.2.0 || ~8.3.0 || ~8.4.0 || ~8.5.0",
        "magento/framework": ">=103.0.0",
        "magento/module-store": ">=101.0.0",
        "magento/module-config": ">=101.0.0",
        "magento/module-catalog": ">=104.0.0"
    },
    "suggest": {
        "magecopilot/module-edge-sync": "Provides background catalog synchronization and CDC directly into Typesense RAM"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "MageCopilot\\SearchIsland\\": ""
        }
    },
    "extra": {
        "installer-name": "MageCopilot_SearchIsland"
    }
}
