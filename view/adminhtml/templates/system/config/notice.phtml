/** @var \Magento\Framework\Escaper $escaper */
$mode = $block->getNoticeMode();
?>
<?php if ($mode === \MageCopilot\SearchIsland\Block\Adminhtml\System\Config\Notice::MODE_MISSING_CREDENTIALS): ?>
<div class="message message-warning"
     style="margin-bottom: 20px; border-left: 5px solid #e17055; background: #fff5f2; padding: 14px 18px;">
    <div style="display: flex; align-items: flex-start; gap: 12px;">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#d63031" stroke-width="2"
             stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0; margin-top:2px;">
            <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/>
            <line x1="12" y1="9" x2="12" y2="13"/>
            <line x1="12" y1="17" x2="12.01" y2="17"/>
        </svg>
        <div>
            <strong style="color: #d63031; font-size: 14px;">
                <?= $escaper->escapeHtml(__('Typesense Credentials Required')) ?>
            </strong>
            <p style="margin: 6px 0 0; color: #2d3436; font-size: 13px; line-height: 1.4;">
                <?= $escaper->escapeHtml(
                    __('Search Island is enabled, but either the Typesense Host URL or Public Search Key is ' .
                       'missing. Search Island will remain inactive on the storefront until valid credentials ' .
                       'are provided below.')
                ) ?>
            </p>
        </div>
    </div>
</div>
<?php else: ?>
    <?php
    $isManaged = ($mode === \MageCopilot\SearchIsland\Block\Adminhtml\System\Config\Notice::MODE_MANAGED_CLOUD);
    $isLocal = ($mode === \MageCopilot\SearchIsland\Block\Adminhtml\System\Config\Notice::MODE_SELF_HOSTED_LOCAL);
    $badgeText = $isManaged
        ? __('Active Endpoint Mode: Managed Memory Grid Cloud')
        : ($isLocal
            ? __('Active Endpoint Mode: Self-Hosted / Local Docker')
            : __('Active Endpoint Mode: Self-Hosted Remote Node'));
    $bodyText = $isManaged
        ? __(
            'Connected to Managed Memory Grid cluster. All SearchIsland OSL-3.0 '
            . 'capabilities operate in full-speed mode.'
        )
        : __(
            'Self-hosted Typesense endpoint detected. SearchIsland operates 100% '
            . 'free and unlocked under OSL-3.0.'
        );
    $accentColor = $isManaged ? '#0f766e' : '#0284c7';
    $bgColor = $isManaged ? '#f0fdfa' : '#f0f9ff';
    $boxStyle = sprintf(
        'margin-bottom: 16px; border-left: 4px solid %s; background: %s; padding: 11px 16px;',
        $accentColor,
        $bgColor
    );
    ?>
<div class="message message-info" style="<?= $escaper->escapeHtmlAttr($boxStyle) ?>">
    <strong style="color: <?= $escaper->escapeHtmlAttr($accentColor) ?>; font-size: 13px;">
        <?= $escaper->escapeHtml($badgeText) ?>
    </strong>
    <p style="margin: 4px 0 0; color: #334155; font-size: 12px; line-height: 1.4;">
        <?= $escaper->escapeHtml($bodyText) ?>
    </p>
</div>
<?php endif; ?>
